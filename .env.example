# Server-only URL used by Next.js to reach Rails.
RAILS_API_URL=http://127.0.0.1:3001

# Public canonical URL used for social metadata in each environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth configuration exposed to the browser (publishable key only).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Rails verifies Supabase access tokens against this issuer's JWKS endpoint.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=ES256

# Rails connects directly to the local Supabase PostgreSQL instance.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54322
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Rails sends workspace invitations through Resend in production.
APP_URL=http://localhost:3000
RESEND_API_KEY=re_your_api_key
MAILER_FROM=SignalDesk <onboarding@resend.dev>
